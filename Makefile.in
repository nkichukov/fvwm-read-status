CC = @CC@
CFLAGS = -Wall -Wextra -O2
LDLIBS = -lcjson

TARGET = fvwm-read-status

all: $(TARGET)

$(TARGET): main.c
	$(CC) $(CFLAGS) -o $@ $< $(LDLIBS)
	strip $@

clean:
	rm -f $(TARGET)

install: $(TARGET)
	install -D -m 755 $(TARGET) $(DESTDIR)@prefix@/bin/$(TARGET)

uninstall:
	rm -f $(DESTDIR)@prefix@/bin/$(TARGET)

.PHONY: all clean install
